# Copy to .config.env (non-secret config) and .dev.env / .env (secrets).
#
# Loaded by db.js:15-17  -> .config.env, then .dev.env (dev) or .env (production)
# Loaded by server.js:21 -> .env

# --- App ---
APP_NAME=boilerplate-api
NODE_ENV=development
PORT=3000
TZ=UTC

# --- Logging ---
# 'morgan' or 'pino'. Required: utils/logger.js throws "Unsupported logger"
# if unset. Only morgan is in package.json today; `npm i pino` before
# selecting pino.
LOGGER=morgan

# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/boilerplate
